# Copia este archivo como .env en la raíz del repositorio y ajusta los valores.
# Nunca subas .env a GitHub.

# PostgreSQL
DATABASE_URL="postgresql://erp:erp@localhost:5432/erp?schema=public"

# API
API_PORT=4000
# Origen público del frontend (para CORS y cookies)
WEB_ORIGIN="http://localhost:3000"
# Duración de la sesión en horas
SESSION_TTL_HOURS=12
# "true" en producción detrás de HTTPS
COOKIE_SECURE=false

# Clave maestra (32 bytes en base64) para cifrar credenciales de integraciones.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIALS_KEY=""

# Usuario administrador inicial que crea el seed (sólo la primera vez)
SEED_ADMIN_EMAIL="admin@zanetti.mx"
SEED_ADMIN_NAME="Administrador"
# Si se deja vacío, el seed genera una contraseña aleatoria y la imprime una vez.
SEED_ADMIN_PASSWORD=""

# Web (Next.js): URL interna de la API para el proxy /api/*
API_URL="http://localhost:4000"

# ─── Producción (docker-compose en el VPS) ───────────────────────────────
# Dominio público; Caddy obtiene el certificado HTTPS automáticamente.
DOMAIN="erp.tudominio.mx"
POSTGRES_USER="erp"
# Contraseña larga y aleatoria:
POSTGRES_PASSWORD=""
POSTGRES_DB="erp"
# En Docker la base se llama "db":
# DATABASE_URL="postgresql://erp:<POSTGRES_PASSWORD>@db:5432/erp?schema=public"
# WEB_ORIGIN="https://erp.tudominio.mx"
# COOKIE_SECURE=true
