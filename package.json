{
  "name": "erp-ecommerce",
  "private": true,
  "version": "0.1.0",
  "description": "ERP ECOMMERCE \u2014 Sistema Integral de Operaciones",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @erp/db generate",
    "db:migrate": "pnpm --filter @erp/db migrate",
    "db:seed": "pnpm --filter @erp/db seed"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "turbo": "^2.11.7",
    "typescript": "~5.8.3"
  }
}
